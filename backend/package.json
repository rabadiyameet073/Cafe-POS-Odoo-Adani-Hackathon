{
    "name": "cafe-pos-server",
    "version": "1.0.0",
    "description": "Cafe POS Backend - Node.js + Express.js API Server",
    "main": "src/server.js",
    "scripts": {
        "start": "node src/server.js",
        "dev": "node --watch src/server.js",
        "test": "jest --runInBand",
        "test:e2e": "jest tests/e2e --runInBand"
    },
    "jest": {
        "testEnvironment": "node",
        "coveragePathIgnorePatterns": [
            "/node_modules/"
        ],
        "testMatch": [
            "**/tests/**/*.test.js"
        ],
        "testTimeout": 30000,
        "setupFilesAfterEnv": [
            "./tests/setup.js"
        ]
    },
    "keywords": [
        "cafe",
        "pos",
        "restaurant",
        "nodejs",
        "express"
    ],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@supabase/supabase-js": "^2.97.0",
        "bcryptjs": "^2.4.3",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "exceljs": "^4.4.0",
        "express": "^4.18.2",
        "express-validator": "^7.0.1",
        "helmet": "^7.1.0",
        "jsonwebtoken": "^9.0.2",
        "morgan": "^1.10.0",
        "pdfkit": "^0.14.0",
        "qrcode": "^1.5.3",
        "socket.io": "^4.7.2",
        "uuid": "^9.0.1",
        "winston": "^3.11.0"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "devDependencies": {
        "@types/jest": "^30.0.0",
        "@types/supertest": "^6.0.3",
        "fast-check": "^4.5.3",
        "jest": "^30.2.0",
        "supertest": "^7.2.2"
    }
}
