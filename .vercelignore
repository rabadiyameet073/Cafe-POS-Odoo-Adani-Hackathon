# Vercel Ignore File

# Node modules (Vercel handles these)
node_modules/
backend/node_modules/
frontend/node_modules/

# Local environment files (use Vercel dashboard for env vars)
.env.local
.env.*.local
backend/.env.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Database files (schema will be in Supabase)
database/*.sql

# Documentation (except README)
*.md
!README.md

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Build artifacts
frontend/dist/
backend/dist/
backend/build/

# Test files
**/*.test.js
**/*.spec.js

# Development scripts
start-dev.bat
start-dev.sh

# Old/backup files
old-assets/
